{"nodes": [{"id": "ssot_arch_logic_l1_client", "label": "L1 \u2014 \u041a\u043b\u0438\u0435\u043d\u0442", "file_type": "concept", "source_file": "ssot/arch-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041c\u043e\u0431\u0438\u043b\u044c\u043d\u044b\u0439 \u043f\u0443\u0442\u044c \u0434\u0430\u0451\u0442 \u0442\u043e\u0442 \u0436\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b \u0431\u0435\u0437 \u0443\u0440\u0435\u0437\u0430\u043d\u0438\u0439; \u0438\u043d\u0434\u0438\u043a\u0430\u0446\u0438\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0439 (\u00ab\u0441\u043a\u0430\u0437\u0430\u043b / \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043b\u0438 / \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e\u00bb, \u00ab\u0434\u0435\u043c\u043e\u00bb, \u00ab\u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d\u00bb) \u0432\u044b\u043d\u043e\u0441\u0438\u0442 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0432 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441."}, {"id": "ssot_arch_logic_l2_orchestration", "label": "L2 \u2014 \u041e\u0440\u043a\u0435\u0441\u0442\u0440\u0430\u0446\u0438\u044f / API", "file_type": "concept", "source_file": "ssot/arch-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u0440\u0438\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043a \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044e, \u0430 \u043d\u0435 \u043a \u0432\u043a\u043b\u0430\u0434\u043a\u0435 \u0438\u043b\u0438 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0443, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 \u043d\u0435 \u0442\u0435\u0440\u044f\u043b\u0438\u0441\u044c \u043f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u043a\u043b\u0438\u0435\u043d\u0442\u0430."}, {"id": "ssot_arch_logic_l3_ai", "label": "L3 \u2014 \u0418\u0418 / \u044f\u0437\u044b\u043a\u043e\u0432\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c", "file_type": "concept", "source_file": "ssot/arch-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041c\u043e\u0434\u0435\u043b\u044c \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0438 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442, \u043d\u043e \u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u043c \u0444\u0430\u043a\u0442\u043e\u0432: \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0435\u0451 \u0432\u044b\u0437\u043e\u0432\u0430 \u043b\u0438\u0448\u044c \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u043f\u0435\u0440\u0435\u0441\u0447\u0451\u0442 \u0432 \u0441\u043b\u043e\u0435 \u043f\u0440\u0430\u0432\u0438\u043b, \u0441\u0430\u043c\u0430 \u043e\u043d\u0430 \u0432 L5 \u043d\u0435 \u043f\u0438\u0448\u0435\u0442."}, {"id": "ssot_arch_logic_l4_deterministic_rules", "label": "L4 \u2014 \u0414\u0435\u0442\u0435\u0440\u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430", "file_type": "concept", "source_file": "ssot/arch-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u041c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e, \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0435\u043c\u043e \u0438 \u0441\u0432\u043e\u0434\u0438\u043c\u043e \u043a \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0443 \u2014 \u0431\u0435\u0437 \u043c\u043e\u0434\u0435\u043b\u0438; \u044d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u0441\u0435\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043f\u0440\u0438 \u043e\u0442\u043a\u0430\u0437\u0435 L3."}, {"id": "ssot_arch_logic_l5_data", "label": "L5 \u2014 \u0414\u0430\u043d\u043d\u044b\u0435 \u0438 \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0435", "file_type": "concept", "source_file": "ssot/arch-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u043f\u0440\u0430\u0432\u0434\u044b \u0438 \u043a\u044d\u0448 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044f \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u043c \u0438 \u0434\u0430\u0442\u043e\u0439 \u0443 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0444\u0430\u043a\u0442\u0430, \u0447\u0442\u043e\u0431\u044b \u043b\u044e\u0431\u043e\u0435 \u0447\u0438\u0441\u043b\u043e \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0435 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c."}, {"id": "ssot_arch_logic_l6_external_sources", "label": "L6 \u2014 \u0412\u043d\u0435\u0448\u043d\u0438\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438", "file_type": "concept", "source_file": "ssot/arch-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0416\u0438\u0432\u043e\u0439 \u043f\u043e\u0438\u0441\u043a \u043f\u043e \u0432\u043d\u0435\u0448\u043d\u0438\u043c API \u0432\u0443\u0437\u043e\u0432 \u00ab\u043d\u0430 \u043b\u0435\u0442\u0443\u0