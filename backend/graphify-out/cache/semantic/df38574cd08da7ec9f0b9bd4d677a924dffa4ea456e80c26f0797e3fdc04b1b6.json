34\u0430\u0442\u0430, \u2014 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0432\u044b\u0437\u043e\u0432\u0430 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430, \u0441 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u043c \u0440\u044f\u0434\u043e\u043c. \u042d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0447\u0435\u0441\u0442\u043d\u043e\u0439."}, {"id": "ssot_arch_logic_model_tools", "label": "\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0434\u043b\u044f \u043c\u043e\u0434\u0435\u043b\u0438 (L2)", "file_type": "concept", "source_file": "ssot/arch-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "ssot_arch_logic_background_queue", "label": "\u041e\u0447\u0435\u0440\u0435\u0434\u044c \u0444\u043e\u043d\u043e\u0432\u044b\u0445 \u0437\u0430\u0434\u0430\u0447 (L2)", "file_type": "concept", "source_file": "ssot/arch-logic.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0412\u0435\u0431-\u043f\u043e\u0438\u0441\u043a \u0438 \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c, \u043c\u044f\u0433\u043a\u043e\u0435 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435, \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u0437\u0430 \u0447\u0430\u0442\u043e\u043c \u0438 \u043f\u0440\u0435\u0434\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u0433\u0430\u0439\u0434\u043b\u0430\u0439\u043d\u043e\u0432 \u0432\u044b\u043d\u0435\u0441\u0435\u043d\u044b \u0432 \u0444\u043e\u043d, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u0432\u0435\u0442 \u0443\u0447\u0435\u043d\u0438\u043a\u0443 \u043d\u0435 \u04