u043d\u0442, \u0438 \u043e\u043d\u0430 \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u043e \u0440\u0435\u0434\u043a\u0430\u044f: \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u0440\u043e\u043b\u0451\u0442 \u0447\u0435\u0440\u0435\u0437 15\u201340 \u0441, \u0434\u0430\u043b\u044c\u0448\u0435 \u0440\u0430\u0437 \u0432 45\u201375 \u0441, \u0438 \u043d\u0430 \u0444\u043e\u043d\u043e\u0432\u043e\u0439 \u0432\u043a\u043b\u0430\u0434\u043a\u0435 \u043d\u0435 \u043b\u0435\u0442\u0430\u0435\u0442."}, {"id": "ssot_design_animations", "label": "\u0410\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0438 \u043a\u0440\u0438\u0432\u044b\u0435 (--ease, --ease-out)", "file_type": "concept", "source_file": "ssot/DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0416\u0438\u0432\u043e\u0441\u0442\u044c \u0431\u0435\u0437 \u0448\u0443\u043c\u0430: \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u044e\u0442 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044b \u2014 \u0447\u0442\u043e \u043e\u0442\u043a\u0443\u0434\u0430 \u043f\u043e\u044f\u0432\u0438\u043b\u043e\u0441\u044c \u0438 \u0447\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c, \u0430 \u043d\u0435 \u0443\u043a\u0440\u0430\u0448\u0430\u044e\u0442; \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u0430\u044f \u043a\u0440\u0438\u0432\u0430\u044f \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u0439 \u043f\u0430\u043d\u0435\u043b\u0435\u0439 \u0438 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u0430\u044f \u0434\u043b\u044f \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0439."}, {"id": "ssot_design_reduced_motion", "label": "\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u00ab\u0443\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u0438\u044f \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f\u00bb", "file_type": "concept", "source_file": "ssot/DESIGN.md", "source_